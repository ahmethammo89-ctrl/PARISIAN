# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only key, never exposed to the browser. Used by
# lib/supabase/admin.ts to create/settle `payments` rows (that table is
# staff-write-only under RLS by design — see parisian_laundry_schema.sql).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Enable phone/OTP: Supabase Dashboard -> Authentication -> Providers -> Phone
# and configure an SMS provider (Twilio, Vonage, MessageBird, ...).

# Whish Money merchant credentials. Leave unset to use the built-in mock
# checkout (app/api/payments/whish uses it automatically) — useful for
# testing the whole order flow before you have live credentials. The
# exact request/payload shape in lib/whish.ts is NOT verified against
# Whish's live API docs — confirm it against your merchant dashboard
# before going live.
# WHISH_API_BASE_URL=
# WHISH_CHANNEL=
# WHISH_SECRET=
# WHISH_API_KEY=

# wa.me number for the "Send order via WhatsApp" button. Defaults to
# 9613703442 (the business card's first branch number, in wa.me format)
# if unset.
# NEXT_PUBLIC_WHATSAPP_NUMBER=9613703442
